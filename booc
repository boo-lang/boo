#!/bin/sh
# Runs the booc built from source. Set BOO_CONFIGURATION=Release for that build.
config=${BOO_CONFIGURATION:-Debug}
root=$(dirname "$0")
exe="$root/src/booc/bin/$config/net10.0/booc"
if [ ! -x "$exe" ]; then
	echo "booc is not built. Run: dotnet build Boo.slnx" >&2
	exit 1
fi
exec "$exe" "$@"
