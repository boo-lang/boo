#!/bin/sh
# Runs the booish built from source. Set BOO_CONFIGURATION=Release for that build.
config=${BOO_CONFIGURATION:-Debug}
root=$(dirname "$0")
exe="$root/src/booish/bin/$config/net10.0/booish"
if [ ! -x "$exe" ]; then
	echo "booish is not built. Run: dotnet build Boo.slnx" >&2
	exit 1
fi
exec "$exe" "$@"
