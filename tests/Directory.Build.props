<Project>

  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!-- The test projects state their own version in Properties/AssemblyInfo. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    A project under tests/ is a test project when it is named for one, whatever
    language it is written in. The rest are support libraries the testcases
    compile against, and must not be handed the test SDK.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
  </ItemGroup>

  <!--
    The test SDK forces OutputType to Exe and generates an entry point in C#,
    neither of which suits booc, so a Boo test project states its target kind
    outright and turns the generated entry point off.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) and '$(MSBuildProjectExtension)' == '.booproj'">
    <BooTargetKind>library</BooTargetKind>
    <GenerateProgramFile>false</GenerateProgramFile>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

</Project>
