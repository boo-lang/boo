<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>BooCompilerSupportingClasses</AssemblyName>
    <RootNamespace>BooCompiler.Tests</RootNamespace>
    <!-- SupportingClasses/Pointers.cs exercises the unsafe testcases. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Named for what it holds rather than for the suite, so the test SDK has to
      be asked for by hand: ReferenceAssemblyDiscoveryTest lives here and would
      otherwise never run.
    -->
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Boo.Lang/Boo.Lang.csproj" />
    <ProjectReference Include="../../src/Boo.Lang.Compiler/Boo.Lang.Compiler.csproj" />
  </ItemGroup>

</Project>
