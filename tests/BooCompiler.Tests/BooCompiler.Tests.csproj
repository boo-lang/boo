<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>BooCompiler.Tests</AssemblyName>
    <RootNamespace>BooCompiler.Tests</RootNamespace>
    <!-- SupportingClasses/Pointers.cs exercises the unsafe testcases. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Boo.Lang/Boo.Lang.csproj" />
    <ProjectReference Include="../../src/Boo.Lang.Compiler/Boo.Lang.Compiler.csproj" />
    <ProjectReference Include="../../src/Boo.Lang.Parser/Boo.Lang.Parser.csproj" />
    <ProjectReference Include="../../src/Boo.Lang.Extensions/Boo.Lang.Extensions.booproj" />
    <ProjectReference Include="../../src/Boo.Lang.PatternMatching/Boo.Lang.PatternMatching.booproj" />
    <ProjectReference Include="../BooSupportingClasses/BooSupportingClasses.booproj" />
    <ProjectReference Include="../BooModules/BooModules.booproj" />
    <ProjectReference Include="../../src/Boo.Lang.Useful/Boo.Lang.Useful.booproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- interfaces-22 needs a concrete IDbCommand. The native SQLite package is
         pinned forward: the one Microsoft.Data.Sqlite asks for carries a high
         severity advisory. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

</Project>
