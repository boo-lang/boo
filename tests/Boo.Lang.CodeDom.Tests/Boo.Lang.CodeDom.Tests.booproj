<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Boo.Lang.CodeDom.Tests</AssemblyName>
    <RootNamespace>Boo.Lang.CodeDom.Tests</RootNamespace>

    <!--
      A Boo test project opts into the test SDK by hand: tests/Directory.Build.props
      hands it only to the C# projects, because the other .booproj files under
      tests/ are support libraries the testcases compile against.

      The test SDK forces OutputType to Exe and generates an entry point in C#,
      neither of which suits booc, so the target kind is stated outright and
      the generated entry point turned off.
    -->
    <IsTestProject>true</IsTestProject>
    <BooTargetKind>library</BooTargetKind>
    <GenerateProgramFile>false</GenerateProgramFile>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Boo.Lang/Boo.Lang.csproj" />
    <ProjectReference Include="../../src/Boo.Lang.Compiler/Boo.Lang.Compiler.csproj" />
    <ProjectReference Include="../../src/Boo.Lang.Parser/Boo.Lang.Parser.csproj" />
    <ProjectReference Include="../../src/Boo.Lang.CodeDom/Boo.Lang.CodeDom.booproj" />
    <ProjectReference Include="../../src/Boo.Lang.PatternMatching/Boo.Lang.PatternMatching.booproj" />
    <ProjectReference Include="../../src/booc/booc.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="../../Boo.Boo.targets" />

</Project>
