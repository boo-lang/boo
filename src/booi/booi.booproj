<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>booi</AssemblyName>
    <RootNamespace>booi</RootNamespace>
    <OutputType>Exe</OutputType>
    <Description>Runs Boo scripts without compiling them to disk.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Boo.Lang/Boo.Lang.csproj" />
    <ProjectReference Include="../Boo.Lang.Compiler/Boo.Lang.Compiler.csproj" />
    <ProjectReference Include="../Boo.Lang.Useful/Boo.Lang.Useful.booproj" />
    <ProjectReference Include="../booc/booc.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishDir" Private="false" ExcludeAssets="all" />
  </ItemGroup>

  <Import Project="../../Boo.targets" />

</Project>
