<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>boo-ls</AssemblyName>
    <RootNamespace>Boo.Lang.Lsp.Cli</RootNamespace>
    <OutputType>Exe</OutputType>
    <Description>Language server for Boo, spoken over stdio.</Description>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>boo-ls</ToolCommandName>
    <PackageId>boo-ls</PackageId>
    <Authors>The Boo Contributors</Authors>
    <PackageTags>boo;lsp;language-server;dotnet-tool;editor</PackageTags>
    <PackageLicenseFile>license.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/boo-dotnet/boo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/boo-dotnet/boo</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../license.txt" Pack="true" PackagePath="/" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Boo.Lang/Boo.Lang.csproj" />
    <ProjectReference Include="../Boo.Lang.Compiler/Boo.Lang.Compiler.csproj" />
    <ProjectReference Include="../Boo.Lang.Lsp/Boo.Lang.Lsp.booproj" />
    <ProjectReference Include="../booc/booc.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="../../Boo.targets" />

</Project>
