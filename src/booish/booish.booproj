<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>booish</AssemblyName>
    <RootNamespace>booish</RootNamespace>
    <OutputType>Exe</OutputType>
    <Description>Interactive Boo prompt.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Boo.Lang/Boo.Lang.csproj" />
    <ProjectReference Include="../Boo.Lang.Compiler/Boo.Lang.Compiler.csproj" />
    <ProjectReference Include="../Boo.Lang.Interpreter/Boo.Lang.Interpreter.booproj" />
    <ProjectReference Include="../Boo.Lang.Useful/Boo.Lang.Useful.booproj" />
    <ProjectReference Include="../booc/booc.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="../../Boo.Boo.targets" />

</Project>
