<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Boo.Lang.PatternMatching</AssemblyName>
    <RootNamespace>Boo.Lang.PatternMatching</RootNamespace>
    <Description>Boo pattern matching: the match macro and its expanders.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Boo.Lang/Boo.Lang.csproj" />
    <ProjectReference Include="../Boo.Lang.Compiler/Boo.Lang.Compiler.csproj" />
    <ProjectReference Include="../Boo.Lang.Extensions/Boo.Lang.Extensions.booproj" />
    <ProjectReference Include="../booc/booc.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="../../Boo.Boo.targets" />

</Project>
