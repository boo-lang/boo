<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Boo.Lang.CodeDom</AssemblyName>
    <RootNamespace>Boo.Lang.CodeDom</RootNamespace>
    <Description>CodeDom provider that generates Boo source.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.CodeDom.Compiler moved out of the framework into this package. -->
    <PackageReference Include="System.CodeDom" Version="10.0.11" />
    <ProjectReference Include="../Boo.Lang/Boo.Lang.csproj" />
    <ProjectReference Include="../Boo.Lang.Compiler/Boo.Lang.Compiler.csproj" />
    <ProjectReference Include="../Boo.Lang.Extensions/Boo.Lang.Extensions.booproj" />
    <ProjectReference Include="../booc/booc.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="../../Boo.Boo.targets" />

</Project>
