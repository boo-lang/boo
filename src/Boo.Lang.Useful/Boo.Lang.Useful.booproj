<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Boo.Lang.Useful</AssemblyName>
    <RootNamespace>Boo.Lang.Useful</RootNamespace>
    <Description>Macros, collections, command line parsing and templating built on Boo.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Boo.Lang/Boo.Lang.csproj" />
    <ProjectReference Include="../Boo.Lang.Compiler/Boo.Lang.Compiler.csproj" />
    <ProjectReference Include="../Boo.Lang.Parser/Boo.Lang.Parser.csproj" />
    <ProjectReference Include="../Boo.Lang.Extensions/Boo.Lang.Extensions.booproj" />
    <ProjectReference Include="../Boo.Lang.PatternMatching/Boo.Lang.PatternMatching.booproj" />
    <ProjectReference Include="../booc/booc.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="../../Boo.targets" />

</Project>
