<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Boo.Microsoft.Build.Tasks</AssemblyName>
    <RootNamespace>Boo.Microsoft.Build.Tasks</RootNamespace>
    <Description>MSBuild task that runs booc.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ManagedCompiler, which Booc derives from, lives in Tasks.Core. -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.9.6" />
    <ProjectReference Include="../Boo.Lang/Boo.Lang.csproj" />
    <ProjectReference Include="../Boo.Lang.Compiler/Boo.Lang.Compiler.csproj" />
    <ProjectReference Include="../Boo.Lang.Extensions/Boo.Lang.Extensions.booproj" />
    <ProjectReference Include="../booc/booc.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="../../Boo.targets" />

</Project>
