<Project>

  <!--
    Builds .boo sources with the Booc task, for projects outside this
    repository. It replaces CoreCompile so that references, output paths and
    project ordering keep coming from the .NET SDK.

    Boo.Boo.targets in the repository root does the same job by running booc
    directly. It has to: the projects it builds come before this task assembly
    in the build order, so the task does not exist yet when they compile.

    Import it from an SDK-style project:

      <Project Sdk="Microsoft.NET.Sdk">
        <PropertyGroup>
          <BooToolPath>path/to/boo</BooToolPath>
        </PropertyGroup>
        <Import Project="$(BooToolPath)/Boo.Microsoft.Build.targets" />
      </Project>
  -->

  <PropertyGroup Condition=" '$(BooToolPath)' == '' ">
    <BooToolPath>$(MSBuildThisFileDirectory)</BooToolPath>
  </PropertyGroup>

  <PropertyGroup>
    <BoocPath Condition=" '$(BoocPath)' == '' ">$(BooToolPath)/booc.dll</BoocPath>

    <DefaultLanguageSourceExtension>.boo</DefaultLanguageSourceExtension>
    <Language>Boo</Language>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- booc writes the assembly attributes itself, from the sources. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- booc emits no reference assembly. -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <UsingTask TaskName="Boo.Microsoft.Build.Tasks.Booc"
             AssemblyFile="$(BooToolPath)/Boo.Microsoft.Build.Tasks.dll" />

  <ItemGroup Condition="'$(EnableDefaultBooItems)' != 'false'">
    <Compile Include="**/*.boo" Exclude="$(BaseOutputPath)/**;$(BaseIntermediateOutputPath)/**;bin/**;obj/**" />
  </ItemGroup>

  <!--
    Compiled Boo code calls into Boo.Lang for its builtins and its runtime
    dispatch, so the assembly has to travel with the output. booc references it
    on its own account at compile time; nothing would copy it otherwise.
  -->
  <ItemGroup Condition="'$(BooReferenceRuntime)' != 'false'">
    <Reference Include="Boo.Lang">
      <HintPath>$(BooToolPath)/Boo.Lang.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Normally supplied by Microsoft.CSharp.targets; nothing to name here. -->
  <Target Name="CreateManifestResourceNames" />

  <Target Name="CoreCompile" DependsOnTargets="$(CoreCompileDependsOn)"
          Inputs="@(Compile);@(ReferencePath)"
          Outputs="@(IntermediateAssembly)">

    <Error Condition="!Exists('$(BoocPath)')"
           Text="booc was not found at $(BoocPath). Set BooToolPath or BoocPath." />

    <!--
      The SDK's framework reference pack must not be passed: booc loads the
      framework from the running runtime, and the ref assemblies would collide
      with the implementation ones.

      Package references need the same treatment for a different reason. The
      SDK resolves them to the ref assembly in the package, which has no method
      bodies, and booc loads what it references rather than reading its
      metadata, because it runs macros and attributes out of them at compile
      time. Where a package contributes an implementation assembly, that is
      what gets passed.
    -->
    <ItemGroup>
      <_BooImplementation Include="@(RuntimeCopyLocalItems)" Condition="'%(Extension)' == '.dll'" />
    </ItemGroup>

    <PropertyGroup>
      <_BooImplementationNames>;@(_BooImplementation->'%(Filename)');</_BooImplementationNames>
    </PropertyGroup>

    <ItemGroup>
      <_BooReference Include="@(ReferencePath)"
                     Condition="'%(ReferencePath.FrameworkReferenceName)' == '' And !$(_BooImplementationNames.Contains(';%(ReferencePath.Filename);'))" />
      <_BooReference Include="@(_BooImplementation)" />
    </ItemGroup>

    <MakeDir Directories="$(ProjectDir)$(IntermediateOutputPath)" />

    <Booc
        BoocPath="$(BoocPath)"
        Sources="@(Compile)"
        OutputAssembly="@(IntermediateAssembly)"
        References="@(_BooReference)"
        Resources="@(_CoreCompileResourceInputs);@(ManifestResourceWithNoCulture);@(ManifestNonResxWithNoCultureOnDisk)"
        ResponseFiles="$(CompilerResponseFile)"
        TargetType="$(OutputType)"
        NoConfig="true"
        NoLogo="$(NoLogo)"
        NoStandardLib="$(NoStdLib)"
        Culture="$(AssemblyCulture)"
        DefineSymbols="$(DefineConstants)"
        DisabledWarnings="$(NoWarn)"
        OptionalWarnings="$(OptionalWarnings)"
        TreatWarningsAsErrors="$(TreatWarningsAsErrors)"
        WarningsAsErrors="$(WarningsAsErrors)"
        EmitDebugInformation="$(DebugSymbols)"
        CheckForOverflowUnderflow="$(CheckForOverflowUnderflow)"
        AllowUnsafeBlocks="$(AllowUnsafeBlocks)"
        DelaySign="$(DelaySign)"
        KeyFile="$(AssemblyOriginatorKeyFile)"
        KeyContainer="$(AssemblyKeyContainerName)"
        Platform="$(PlatformTarget)"
        Pipeline="$(Pipeline)"
        Ducky="$(Ducky)"
        Strict="$(Strict)"
        WhiteSpaceAgnostic="$(WhiteSpaceAgnostic)"
        GenerateFullPaths="$(GenerateFullPaths)"
        SourceDirectory="$(SourceDirectory)"
        Utf8Output="$(Utf8Output)"
        Verbosity="$(BoocVerbosity)" />

    <ItemGroup>
      <FileWrites Include="@(IntermediateAssembly)" />
    </ItemGroup>

    <CallTarget Targets="$(TargetsTriggeredByCompilation)"
                Condition="'$(TargetsTriggeredByCompilation)' != ''" />
  </Target>

</Project>
