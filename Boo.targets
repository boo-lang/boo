<Project>

  <!--
    Builds .boo sources with the stage-1 booc produced from the C# core.
    Replaces CoreCompile so that references, output paths and project
    ordering keep coming from the .NET SDK.
  -->

  <PropertyGroup>
    <DefaultLanguageSourceExtension>.boo</DefaultLanguageSourceExtension>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!--
      booc is a tool here, not a reference, so it is built once against the
      plain framework however the project consuming it is targeted. A project
      that follows BooCompiler.Tests onto net10.0-windows must still look for
      booc under net10.0.
    -->
    <BoocTargetFramework Condition="'$(BoocTargetFramework)' == ''">$(TargetFramework)</BoocTargetFramework>
    <BoocTargetFramework Condition="$(BoocTargetFramework.Contains('-'))">$(BoocTargetFramework.Substring(0, $(BoocTargetFramework.IndexOf('-'))))</BoocTargetFramework>

    <BoocDll Condition="'$(BoocDll)' == ''">$(MSBuildThisFileDirectory)src/booc/bin/$(Configuration)/$(BoocTargetFramework)/booc.dll</BoocDll>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableDefaultBooItems)' != 'false'">
    <BooCompile Include="**/*.boo" Exclude="$(BaseOutputPath)/**;$(BaseIntermediateOutputPath)/**;bin/**;obj/**" />

    <!--
      The SDK's own glob is off above and booc is only ever handed .boo, so a
      C# file here belongs to no item group at all. It would be left out with
      no error and no warning, which is how a converted test project loses a
      fixture without anything noticing.
    -->
    <BooForeignSource Include="**/*.cs" Exclude="$(BaseOutputPath)/**;$(BaseIntermediateOutputPath)/**;bin/**;obj/**" />
  </ItemGroup>

  <Target Name="BoocTarget" DependsOnTargets="$(CoreCompileDependsOn);_BooRecordInputs"
          Inputs="@(BooCompile);@(ReferencePath);@(RuntimeCopyLocalItems);$(BoocDll);$(MSBuildAllProjects);$(ProjectDir)$(IntermediateOutputPath)$(MSBuildProjectName).booinputs"
          Outputs="$(ProjectDir)$(IntermediateOutputPath)$(TargetFileName)">
    <Error Condition="!Exists('$(BoocDll)')"
           Text="booc was not found at $(BoocDll). Build src/booc first." />

    <Error Condition="'@(BooForeignSource)' != ''"
           Text="A Boo project compiles only .boo, so these would be dropped without a word: @(BooForeignSource, ', '). Move them to a C# project, or set EnableDefaultBooItems=false and list the sources by hand." />

    <ItemGroup>
      <_BooImplementation Include="@(RuntimeCopyLocalItems)" Condition="'%(Extension)' == '.dll'" />
    </ItemGroup>

    <PropertyGroup>
      <_BooImplementationNames>;@(_BooImplementation->'%(Filename)');</_BooImplementationNames>
    </PropertyGroup>

    <ItemGroup>
      <_BooReference Include="@(ReferencePath)"
                     Condition="'%(ReferencePath.FrameworkReferenceName)' == '' And !$(_BooImplementationNames.Contains(';%(ReferencePath.Filename);'))" />
      <_BooReference Include="@(_BooImplementation)" />
    </ItemGroup>

    <MakeDir Directories="$(ProjectDir)$(IntermediateOutputPath)" />

    <!-- Every reference is passed below, so the implicit Boo.Lang.Extensions
         is only in the way: it collides when compiling Extensions itself. -->
    <Exec Command="dotnet &quot;$(BoocDll)&quot; -noconfig -noextensions -target:$(_BooTargetKind) $(_BooDebug) -out:&quot;$(_BooOutput)&quot; @(_BooReference->'-r:&quot;%(FullPath)&quot;', ' ') @(BooCompile->'&quot;%(FullPath)&quot;', ' ')"
          StandardOutputImportance="normal" />
  </Target>

  <!--
    What booc is told besides the references, worked out in one place and
    written down. A source that is deleted is no longer an input, and a changed
    option is not a changed file, so nothing would look newer than the output and
    the stale output would stand. Writing the options and the list of sources to a
    file, only when it differs, gives either something to change.
  -->
  <Target Name="_BooRecordInputs">
    <PropertyGroup>
      <!--
        BooTargetKind wins over OutputType. A Boo test project needs it: the
        test SDK sets OutputType to Exe from its own targets, which import
        after anything the project file can say, and a test assembly has no
        entry point for booc to find.
      -->
      <_BooTargetKind>$(BooTargetKind)</_BooTargetKind>
      <_BooTargetKind Condition="'$(_BooTargetKind)' == '' And '$(OutputType)' == 'Exe'">exe</_BooTargetKind>
      <_BooTargetKind Condition="'$(_BooTargetKind)' == '' And '$(OutputType)' == 'WinExe'">winexe</_BooTargetKind>
      <_BooTargetKind Condition="'$(_BooTargetKind)' == ''">library</_BooTargetKind>
      <_BooOutput>$(ProjectDir)$(IntermediateOutputPath)$(TargetFileName)</_BooOutput>

      <!--
        Symbols are written when the project asks for them: DebugType is anything
        but none. booc embeds them, as a portable PDB, so there is no .pdb to
        find. Boo.Sdk makes that a Debug build thing; a project that does not use
        it keeps the SDK's own default, which is to ask in every configuration.
      -->
      <_BooDebug>-debug-</_BooDebug>
      <_BooDebug Condition="'$(DebugType)' != '' And '$(DebugType)' != 'none'">-debug+</_BooDebug>
    </PropertyGroup>

    <MakeDir Directories="$(ProjectDir)$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(ProjectDir)$(IntermediateOutputPath)$(MSBuildProjectName).booinputs"
                      Lines="-target:$(_BooTargetKind) $(_BooDebug);@(BooCompile->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Normally supplied by Microsoft.CSharp.targets; nothing to name here. -->
  <Target Name="CreateManifestResourceNames" />

  <!-- CoreCompile is what the SDK calls; point it at booc. -->
  <Target Name="CoreCompile" DependsOnTargets="BoocTarget">
    <ItemGroup>
      <FileWrites Include="$(ProjectDir)$(IntermediateOutputPath)$(TargetFileName)" />
      <FileWrites Include="$(ProjectDir)$(IntermediateOutputPath)$(MSBuildProjectName).booinputs" />
    </ItemGroup>
  </Target>

</Project>
